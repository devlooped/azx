<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>azx</PackageId>
    <RootNamespace>azx</RootNamespace>
    <AssemblyName>azx</AssemblyName>
    <Description>Execute the bundled Azure CLI. ndnx azx -- account list.</Description>
    <PackAsTool>true</PackAsTool>
    <PublishAot>true</PublishAot>
    <ToolCommandName>azx</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
    <IsPackable>true</IsPackable>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
    <RestoreSources Condition="Exists('$(PackageOutputPath)')">$(PackageOutputPath);$(RestoreSources)</RestoreSources>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>

  <!--
    Pointer (`dotnet pack`): DotnetTool v2 settings listing azx.{rid}.
    RID (`dotnet pack -r`): AOT tool plus the azx.cli Payload.
    Do not suffix PackageId here; the SDK appends $(RuntimeIdentifier) for DotnetToolRidPackage.
  -->

  <ItemGroup>
    <PackageReference Include="azx.cli" Version="$(Version)" />
    <PackageReference Include="Readme" Version="1.2.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
